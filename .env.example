# ── Jarvis Config ──────────────────────────────────────────────────────────────

# Wake word to listen for (must match a pre-trained openWakeWord model)
# Options: hey_jarvis | alexa | hey_mycroft | ok_nabu
JARVIS_WAKE_WORD=hey_jarvis

# Whisper model size — tradeoff between speed and accuracy
# tiny=fastest (~75MB), base=good balance (~145MB), small=better, medium=best
WHISPER_MODEL=base

# Wake word detection sensitivity (0.0–1.0)
# Lower = triggers more easily (more false positives)
# Higher = requires clearer pronunciation (fewer false positives)
WAKE_THRESHOLD=0.5
