# ── Jarvis Config ──────────────────────────────────────────────────────────────

# Wake word (must match a pre-trained openWakeWord model)
# Options: hey_jarvis | alexa | hey_mycroft | ok_nabu
JARVIS_WAKE_WORD=hey_jarvis

# Ollama model — must be pulled first: ollama pull <name>
# Fast/small: llama3.2:1b  (~600 MB)
# Balanced:   llama3.2     (~2 GB)   ← default
# Capable:    mistral       (~4 GB)
OLLAMA_MODEL=llama3.2

# Whisper transcription model
# tiny=fastest, base=good balance, small=better, medium=best
WHISPER_MODEL=base

# Wake word sensitivity (0.0–1.0). Lower = more sensitive.
WAKE_THRESHOLD=0.5
